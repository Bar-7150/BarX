# Copy this file to .env.production and replace placeholders.
# Use live values for the production deployment.

NEXT_PUBLIC_APP_NAME=BarX
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_live_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_live_service_role_key
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_live_razorpay_key_id
RAZORPAY_KEY_SECRET=your_live_razorpay_secret
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
NODE_ENV=production
